{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "src/core/types"
    ],
    "baseUrl": ".",
    "paths": {
      "@modules/*": [
        "src/modules/*"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@generated/*": [
        "generated/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/core/types/express.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}