generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:password@localhost:5432/inmohub_local?schema=public"
}

model Ping {
  id    Int    @id @default(autoincrement())
  value String
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  displayName String           @map("display_name")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  permissions RolePermission[]
  users       UserRole[]
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  isActive     Boolean    @default(true) @map("is_active")
  emailVerified        DateTime? @map("email_verified")
  verificationToken    String?   @map("verification_token")
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  roles        UserRole[]

  assignments          Assignment[]
  followUps            FollowUp[]
  mailboxing           Mailboxing[]
  remindersCreated     Reminder[]   @relation("ReminderCreator")
  remindersResponsible Reminder[]   @relation("ReminderResponsible")

  capturedProperties            Property[]             @relation("PropertyCapturedBy")
  propertyAttachmentsUploaded   PropertyAttachment[]   @relation("PropertyAttachmentUploadedBy")
  buildingAttachmentsUploaded   BuildingAttachment[]   @relation("BuildingAttachmentUploadedBy")
  mailboxingAttachmentsUploaded MailboxingAttachment[] @relation("MailboxingAttachmentUploadedBy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model Permission {
  id        Int              @id @default(autoincrement())
  action    String
  module    String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  roles     RolePermission[]

  @@unique([action, module])
}

model UserRole {
  userId    Int       @map("user_id")
  roleId    Int       @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("UserRole")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("RolePermission")
}

model Building {
  id          Int                  @id @default(autoincrement())
  street      String
  number      Int
  block       String?
  stair       String?
  contactId   Int?                 @map("contact_id")
  presidentId Int?                 @map("president_id")
  informerId  Int?                 @map("informer_id")
  noDisturb   Boolean              @default(false) @map("no_disturb")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  assignments Assignment[]
  contact     Person?              @relation("BuildingContact", fields: [contactId], references: [id])
  informer    Person?              @relation("BuildingInformer", fields: [informerId], references: [id])
  president   Person?              @relation("BuildingPresident", fields: [presidentId], references: [id])
  attachments BuildingAttachment[]
  mailboxing  Mailboxing[]
  properties  Property[]
  reminders   Reminder[]

  @@unique([number, block, stair, street])
  @@index([number, block, stair, street], map: "idx_building")
  @@index([street], map: "idx_building_street")
}

model Property {
  id                Int                  @id @default(autoincrement())
  inmovillaCode     Int                  @map("inmovilla_code")
  number            String
  floor             Int
  buildingId        Int                  @map("building_id")
  ownerId           Int?                 @map("owner_id")
  tenantId          Int?                 @map("tenant_id")
  capturedById      Int?                 @map("captured_by_id")
  appraisalPrice    Decimal?             @map("appraisal_price")
  occupiedBy        String?              @map("occupied_by")
  importantNotice   String?              @map("important_notice")
  rso_comment       String?              @map("rso_comment")
  noDisturb         Boolean              @default(false) @map("no_disturb")
  noDoormat         Boolean              @default(false) @map("no_doormat")
  noBell            Boolean              @default(false) @map("no_bell")
  noCounter         Boolean              @default(false) @map("no_counter")
  soldRentedUs      Boolean              @default(false) @map("sold_rented_us")
  branch            String?
  salePrice         Decimal?             @map("sale_price")
  rentalPrice       Decimal?             @map("rental_price")
  status            PropertyStatus       @default(sin_estado) @map("status")
  isPresident       Boolean              @default(false) @map("is_president")
  isInformer        Boolean              @default(false) @map("is_informer")
  isSecondResidence Boolean              @default(false) @map("is_second_residence")
  isOpportunity     Boolean              @default(false) @map("is_opportunity")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
  followUps         FollowUp[]
  listings          Listing[]
  building          Building             @relation(fields: [buildingId], references: [id])
  capturedBy        User?                @relation("PropertyCapturedBy", fields: [capturedById], references: [id])
  owner             Person?              @relation("PropertyOwner", fields: [ownerId], references: [id])
  tenant            Person?              @relation("PropertyTenant", fields: [tenantId], references: [id])
  attachments       PropertyAttachment[]
  propertyPersons   PropertyPerson[]
  reminders         Reminder[]

  @@unique([number, floor, buildingId])
  @@index([buildingId], map: "idx_property_building")
  @@index([inmovillaCode], map: "idx_property_inmovilla_code")
}

model PropertyAttachment {
  id           Int       @id @default(autoincrement())
  propertyId   Int       @map("property_id")
  fileName     String?   @map("file_name")
  mimeType     String?   @map("mime_type")
  fileSize     Int?      @map("file_size")
  s3Key        String    @map("s3_key")
  url          String
  uploadedById Int?      @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  property     Property  @relation(fields: [propertyId], references: [id])
  uploadedBy   User?     @relation("PropertyAttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model BuildingAttachment {
  id           Int       @id @default(autoincrement())
  buildingId   Int       @map("building_id")
  fileName     String?   @map("file_name")
  mimeType     String?   @map("mime_type")
  fileSize     Int?      @map("file_size")
  s3Key        String    @map("s3_key")
  url          String
  uploadedById Int?      @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  building     Building  @relation(fields: [buildingId], references: [id])
  uploadedBy   User?     @relation("BuildingAttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model Assignment {
  id         Int            @id @default(autoincrement())
  userId     Int            @map("user_id")
  buildingId Int            @map("building_id")
  type       AssignmentType
  startDate  DateTime       @map("start_date")
  endDate    DateTime       @map("end_date")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")
  building   Building       @relation(fields: [buildingId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
}

model FollowUp {
  id                  Int                  @id @default(autoincrement())
  sellerId            Int                  @map("seller_id")
  propertyId          Int                  @map("property_id")
  wasContacted        Boolean              @map("was_contacted")
  contactType         String?              @map("contact_type")
  letterType          String?              @map("letter_type")
  observationType     String?              @map("observation_type")
  plannedDate         DateTime?            @map("planned_date")
  executedDate        DateTime?            @map("executed_date")
  comment             String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  property            Property             @relation(fields: [propertyId], references: [id])
  seller              User                 @relation(fields: [sellerId], references: [id])
  reminders           Reminder[]
  reminderOccurrences ReminderOccurrence[]

  @@index([sellerId], map: "idx_follow_up_seller")
  @@index([propertyId], map: "idx_follow_up_property")
  @@index([plannedDate], map: "idx_follow_up_planned")
  @@index([executedDate], map: "idx_follow_up_executed")
}

model Mailboxing {
  id          Int                    @id @default(autoincrement())
  mailboxerId Int                    @map("mailboxer_id")
  buildingId  Int                    @map("building_id")
  status      MailboxingStatus       @default(outside)
  comment     String?
  date        DateTime               @map("date")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  building    Building               @relation(fields: [buildingId], references: [id])
  mailboxer   User                   @relation(fields: [mailboxerId], references: [id])
  attachments MailboxingAttachment[]
}

model MailboxingAttachment {
  id           Int        @id @default(autoincrement())
  mailboxingId Int        @map("mailboxing_id")
  fileName     String?    @map("file_name")
  mimeType     String?    @map("mime_type")
  fileSize     Int?       @map("file_size")
  s3Key        String     @map("s3_key")
  url          String
  uploadedById Int?       @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  mailboxing   Mailboxing @relation(fields: [mailboxingId], references: [id])
  uploadedBy   User?      @relation("MailboxingAttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model Person {
  id                 Int              @id @default(autoincrement())
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  email              String?          @unique
  birthDate          DateTime?        @map("birth_date")
  gender             String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  contactBuildings   Building[]       @relation("BuildingContact")
  informerBuildings  Building[]       @relation("BuildingInformer")
  presidentBuildings Building[]       @relation("BuildingPresident")
  phones             PersonPhone[]
  propertiesOwned    Property[]       @relation("PropertyOwner")
  propertiesTenanted Property[]       @relation("PropertyTenant")
  propertyPersons    PropertyPerson[]
  reminders          Reminder[]
}

model PersonPhone {
  id        Int       @id @default(autoincrement())
  personId  Int       @map("person_id")
  phone     String
  type      PhoneType @map("type")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  person    Person    @relation(fields: [personId], references: [id])
}

model Reminder {
  id               Int                    @id @default(autoincrement())
  title            String
  note             String?
  responsibleId    Int                    @map("responsible_id")
  creatorId        Int                    @map("creator_id")
  propertyId       Int?                   @map("property_id")
  buildingId       Int?                   @map("building_id")
  personId         Int?                   @map("person_id")
  followUpId       Int?                   @map("follow_up_id")
  scheduledAt      DateTime               @map("scheduled_at")
  timezone         String                 @default("Europe/Madrid")
  recurrenceType   ReminderRecurrenceType @map("recurrence_type")
  recurrenceRule   String?                @map("recurrence_rule")
  recurrenceEndsAt DateTime?              @map("recurrence_ends_at")
  status           ReminderStatus         @default(active)
  metadata         Json?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")
  building         Building?              @relation(fields: [buildingId], references: [id])
  creator          User                   @relation("ReminderCreator", fields: [creatorId], references: [id])
  followUp         FollowUp?              @relation(fields: [followUpId], references: [id])
  person           Person?                @relation(fields: [personId], references: [id])
  property         Property?              @relation(fields: [propertyId], references: [id])
  responsible      User                   @relation("ReminderResponsible", fields: [responsibleId], references: [id])
  occurrences      ReminderOccurrence[]

  @@index([responsibleId], map: "idx_reminder_responsible")
  @@index([scheduledAt], map: "idx_reminder_scheduled_at")
  @@index([status], map: "idx_reminder_status")
}

model ReminderOccurrence {
  id                   Int                      @id @default(autoincrement())
  reminderId           Int                      @map("reminder_id")
  followUpId           Int?                     @map("follow_up_id")
  scheduledFor         DateTime                 @map("scheduled_for")
  originalScheduledFor DateTime?                @map("original_scheduled_for")
  timezone             String                   @default("Europe/Madrid")
  status               ReminderOccurrenceStatus @default(pending)
  completedAt          DateTime?                @map("completed_at")
  skippedAt            DateTime?                @map("skipped_at")
  skippedReason        String?                  @map("skipped_reason")
  autoGenerated        Boolean                  @default(true) @map("auto_generated")
  sequence             Int                      @default(0)
  metadata             Json?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  followUp             FollowUp?                @relation(fields: [followUpId], references: [id])
  reminder             Reminder                 @relation(fields: [reminderId], references: [id])

  @@index([scheduledFor], map: "idx_reminder_occurrence_scheduled")
  @@index([status], map: "idx_reminder_occurrence_status")
  @@index([followUpId], map: "idx_reminder_occurrence_followup")
}

model Listing {
  id              Int           @id @default(autoincrement())
  propertyId      Int           @map("property_id")
  listingTypeId   Int           @map("listing_type_id")
  listingStatusId Int           @map("listing_status_id")
  price           Decimal
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  listingStatus   ListingStatus @relation(fields: [listingStatusId], references: [id])
  listingType     ListingType   @relation(fields: [listingTypeId], references: [id])
  property        Property      @relation(fields: [propertyId], references: [id])
}

model ListingType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  listings  Listing[]
}

model ListingStatus {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  listings  Listing[]
}

model PropertyPerson {
  id         Int                @id @default(autoincrement())
  propertyId Int                @map("property_id")
  personId   Int                @map("person_id")
  role       PropertyPersonRole @map("role")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?          @map("deleted_at")
  person     Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, personId, role])
  @@index([propertyId])
  @@index([personId])
  @@index([role])
  @@map("PropertyPerson")
}

enum AssignmentType {
  Following
  Mailboxing
}

enum PhoneType {
  Mobile
  Home
  Work
  Other
}

enum PropertyStatus {
  sin_estado
  noticia_venta
  noticia_alquiler
  antiguo_cliente
}

enum ReminderRecurrenceType {
  once
  daily
  weekly
  monthly
  custom
}

enum ReminderStatus {
  active
  paused
  cancelled
  archived
}

enum ReminderOccurrenceStatus {
  pending
  completed
  skipped
  cancelled
}

enum MailboxingStatus {
  inside
  outside
  no_disturb
}

enum PropertyPersonRole {
  owner
  tenant
}
