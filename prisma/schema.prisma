generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ping {
  id    Int    @id @default(autoincrement())
  value String
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  displayName String           @map("display_name")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  permissions RolePermission[]
  users       UserRole[]
}

model User {
  id                   Int        @id @default(autoincrement())
  email                String     @unique
  passwordHash         String     @map("password_hash")
  firstName            String     @map("first_name")
  lastName             String     @map("last_name")
  phone                String?
  avatarUrl            String?    @map("avatar_url")
  isActive             Boolean    @default(true) @map("is_active")
  emailVerified        DateTime?  @map("email_verified")
  verificationToken    String?    @map("verification_token")
  resetPasswordToken   String?    @map("reset_password_token")
  resetPasswordExpires DateTime?  @map("reset_password_expires")
  roles                UserRole[]

  assignments          Assignment[]
  followUps            FollowUp[]
  mailboxing           Mailboxing[]
  remindersCreated     Reminder[]   @relation("ReminderCreator")
  remindersResponsible Reminder[]   @relation("ReminderResponsible")

  capturedProperties            Property[]             @relation("PropertyCapturedBy")
  propertyAttachmentsUploaded   PropertyAttachment[]   @relation("PropertyAttachmentUploadedBy")
  buildingAttachmentsUploaded   BuildingAttachment[]   @relation("BuildingAttachmentUploadedBy")
  mailboxingAttachmentsUploaded MailboxingAttachment[] @relation("MailboxingAttachmentUploadedBy")
  flyersGenerated               Flyer[]                @relation("FlyerGeneratedBy")
  flyerShipments                FlyerShipment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  completedTours String[] @default([]) @map("completed_tours")

  // Board relations
  boardsCreated       Board[]                 @relation("BoardCreator")
  boardsOwned         Board[]                 @relation("BoardOwner")
  cardsCreated        BoardCard[]             @relation("CardCreator")
  cardsResponsible    BoardCard[]             @relation("CardResponsible")
  cardActivities      CardActivity[]
  ocrHistory          OcrHistory[]
  forumTopics         ForumTopic[]
  forumPosts          ForumPost[]
  valuationConfigs    ValuationWidgetConfig[]
  valuationsGenerated ValuationRequest[]      @relation("ValuationGeneratedBy")

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
  apiKeys   ApiKey[]
}

model Permission {
  id        Int              @id @default(autoincrement())
  action    String
  module    String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  roles     RolePermission[]

  @@unique([action, module])
}

model UserRole {
  userId    Int       @map("user_id")
  roleId    Int       @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("UserRole")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("RolePermission")
}

model Building {
  id          Int                  @id @default(autoincrement())
  street      String
  number      Int
  block       String?
  stair       String?
  contactId   Int?                 @map("contact_id")
  presidentId Int?                 @map("president_id")
  informerId  Int?                 @map("informer_id")
  noDisturb   Boolean              @default(false) @map("no_disturb")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  assignments Assignment[]
  contact     Person?              @relation("BuildingContact", fields: [contactId], references: [id])
  informer    Person?              @relation("BuildingInformer", fields: [informerId], references: [id])
  president   Person?              @relation("BuildingPresident", fields: [presidentId], references: [id])
  attachments BuildingAttachment[]
  mailboxing  Mailboxing[]
  properties  Property[]
  reminders   Reminder[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([number, block, stair, street])
  @@index([number, block, stair, street], map: "idx_building")
  @@index([street], map: "idx_building_street")
}

model Property {
  id                Int                  @id @default(autoincrement())
  inmovillaCode     Int                  @map("inmovilla_code")
  number            String
  floor             Int
  buildingId        Int                  @map("building_id")
  ownerId           Int?                 @map("owner_id")
  tenantId          Int?                 @map("tenant_id")
  capturedById      Int?                 @map("captured_by_id")
  appraisalPrice    Decimal?             @map("appraisal_price")
  occupiedBy        String?              @map("occupied_by")
  importantNotice   String?              @map("important_notice")
  rso_comment       String?              @map("rso_comment")
  noDisturb         Boolean              @default(false) @map("no_disturb")
  noDoormat         Boolean              @default(false) @map("no_doormat")
  noBell            Boolean              @default(false) @map("no_bell")
  noCounter         Boolean              @default(false) @map("no_counter")
  soldRentedUs      Boolean              @default(false) @map("sold_rented_us")
  branch            String?
  salePrice         Decimal?             @map("sale_price")
  rentalPrice       Decimal?             @map("rental_price")
  status            PropertyStatus       @default(sin_estado) @map("status")
  isPresident       Boolean              @default(false) @map("is_president")
  isInformer        Boolean              @default(false) @map("is_informer")
  isSecondResidence Boolean              @default(false) @map("is_second_residence")
  isOpportunity     Boolean              @default(false) @map("is_opportunity")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
  description       String?              @map("description")
  followUps         FollowUp[]
  listings          Listing[]
  building          Building             @relation(fields: [buildingId], references: [id])
  capturedBy        User?                @relation("PropertyCapturedBy", fields: [capturedById], references: [id])
  owner             Person?              @relation("PropertyOwner", fields: [ownerId], references: [id])
  tenant            Person?              @relation("PropertyTenant", fields: [tenantId], references: [id])
  attachments       PropertyAttachment[]
  propertyPersons   PropertyPerson[]
  reminders         Reminder[]
  flyers            Flyer[]
  valuations        ValuationRequest[]
  mailboxing        MailboxingProperty[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([number, floor, buildingId])
  @@index([buildingId], map: "idx_property_building")
  @@index([inmovillaCode], map: "idx_property_inmovilla_code")
}

model PropertyAttachment {
  id           Int       @id @default(autoincrement())
  propertyId   Int       @map("property_id")
  fileName     String?   @map("file_name")
  mimeType     String?   @map("mime_type")
  fileSize     Int?      @map("file_size")
  s3Key        String    @map("s3_key")
  url          String
  uploadedById Int?      @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  property     Property  @relation(fields: [propertyId], references: [id])
  uploadedBy   User?     @relation("PropertyAttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model BuildingAttachment {
  id           Int       @id @default(autoincrement())
  buildingId   Int       @map("building_id")
  fileName     String?   @map("file_name")
  mimeType     String?   @map("mime_type")
  fileSize     Int?      @map("file_size")
  s3Key        String    @map("s3_key")
  url          String
  uploadedById Int?      @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  building     Building  @relation(fields: [buildingId], references: [id])
  uploadedBy   User?     @relation("BuildingAttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model Assignment {
  id         Int            @id @default(autoincrement())
  userId     Int            @map("user_id")
  buildingId Int            @map("building_id")
  type       AssignmentType
  startDate  DateTime       @map("start_date")
  endDate    DateTime       @map("end_date")
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")
  building   Building       @relation(fields: [buildingId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
}

model FollowUp {
  id                  Int                  @id @default(autoincrement())
  sellerId            Int                  @map("seller_id")
  propertyId          Int                  @map("property_id")
  wasContacted        Boolean              @map("was_contacted")
  contactType         String?              @map("contact_type")
  letterType          String?              @map("letter_type")
  observationType     String?              @map("observation_type")
  plannedDate         DateTime?            @map("planned_date")
  executedDate        DateTime?            @map("executed_date")
  comment             String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  property            Property             @relation(fields: [propertyId], references: [id])
  seller              User                 @relation(fields: [sellerId], references: [id])
  reminders           Reminder[]
  reminderOccurrences ReminderOccurrence[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([sellerId], map: "idx_follow_up_seller")
  @@index([propertyId], map: "idx_follow_up_property")
  @@index([plannedDate], map: "idx_follow_up_planned")
  @@index([executedDate], map: "idx_follow_up_executed")
}

enum MailboxingExecutionStatus {
  pending
  completed
  skipped
  cancelled
}

model Mailboxing {
  id               Int                       @id @default(autoincrement())
  mailboxerId      Int                       @map("mailboxer_id")
  buildingId       Int                       @map("building_id")
  status           MailboxingStatus          @default(outside)
  executionStatus  MailboxingExecutionStatus @default(completed) @map("execution_status")
  comment          String?
  date             DateTime                  @map("date")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  building    Building               @relation(fields: [buildingId], references: [id])
  properties  MailboxingProperty[]
  mailboxer   User                   @relation(fields: [mailboxerId], references: [id])
  attachments MailboxingAttachment[]
}

model MailboxingProperty {
  id           Int        @id @default(autoincrement())
  mailboxingId Int        @map("mailboxing_id")
  propertyId   Int        @map("property_id")
  mailboxing   Mailboxing @relation(fields: [mailboxingId], references: [id])
  property     Property   @relation(fields: [propertyId], references: [id])
}

model MailboxingAttachment {
  id           Int        @id @default(autoincrement())
  mailboxingId Int        @map("mailboxing_id")
  fileName     String?    @map("file_name")
  mimeType     String?    @map("mime_type")
  fileSize     Int?       @map("file_size")
  s3Key        String     @map("s3_key")
  url          String
  uploadedById Int?       @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  mailboxing   Mailboxing @relation(fields: [mailboxingId], references: [id])
  uploadedBy   User?      @relation("MailboxingAttachmentUploadedBy", fields: [uploadedById], references: [id])
}

model Person {
  id                     Int                    @id @default(autoincrement())
  firstName              String                 @map("first_name")
  lastName               String                 @map("last_name")
  email                  String?                @unique
  birthDate              DateTime?              @map("birth_date")
  gender                 String?
  notificationPreference NotificationPreference @default(NONE) @map("notification_preference")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")
  contactBuildings       Building[]             @relation("BuildingContact")
  informerBuildings      Building[]             @relation("BuildingInformer")
  presidentBuildings     Building[]             @relation("BuildingPresident")
  phones                 PersonPhone[]
  propertiesOwned        Property[]             @relation("PropertyOwner")
  propertiesTenanted     Property[]             @relation("PropertyTenant")
  propertyPersons        PropertyPerson[]
  reminders              Reminder[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
}

model PersonPhone {
  id        Int       @id @default(autoincrement())
  personId  Int       @map("person_id")
  phone     String
  type      PhoneType @map("type")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  person    Person    @relation(fields: [personId], references: [id])
}

model Reminder {
  id               Int                    @id @default(autoincrement())
  title            String
  note             String?
  responsibleId    Int                    @map("responsible_id")
  creatorId        Int                    @map("creator_id")
  propertyId       Int?                   @map("property_id")
  buildingId       Int?                   @map("building_id")
  personId         Int?                   @map("person_id")
  followUpId       Int?                   @map("follow_up_id")
  scheduledAt      DateTime               @map("scheduled_at")
  timezone         String                 @default("Europe/Madrid")
  recurrenceType   ReminderRecurrenceType @map("recurrence_type")
  recurrenceRule   String?                @map("recurrence_rule")
  recurrenceEndsAt DateTime?              @map("recurrence_ends_at")
  status           ReminderStatus         @default(active)
  metadata         Json?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")
  building         Building?              @relation(fields: [buildingId], references: [id])
  creator          User                   @relation("ReminderCreator", fields: [creatorId], references: [id])
  followUp         FollowUp?              @relation(fields: [followUpId], references: [id])
  person           Person?                @relation(fields: [personId], references: [id])
  property         Property?              @relation(fields: [propertyId], references: [id])
  responsible      User                   @relation("ReminderResponsible", fields: [responsibleId], references: [id])
  occurrences      ReminderOccurrence[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([responsibleId], map: "idx_reminder_responsible")
  @@index([scheduledAt], map: "idx_reminder_scheduled_at")
  @@index([status], map: "idx_reminder_status")
}

model ReminderOccurrence {
  id                   Int                      @id @default(autoincrement())
  reminderId           Int                      @map("reminder_id")
  followUpId           Int?                     @map("follow_up_id")
  scheduledFor         DateTime                 @map("scheduled_for")
  originalScheduledFor DateTime?                @map("original_scheduled_for")
  timezone             String                   @default("Europe/Madrid")
  status               ReminderOccurrenceStatus @default(pending)
  completedAt          DateTime?                @map("completed_at")
  skippedAt            DateTime?                @map("skipped_at")
  skippedReason        String?                  @map("skipped_reason")
  autoGenerated        Boolean                  @default(true) @map("auto_generated")
  sequence             Int                      @default(0)
  metadata             Json?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  followUp             FollowUp?                @relation(fields: [followUpId], references: [id])
  reminder             Reminder                 @relation(fields: [reminderId], references: [id])

  @@index([scheduledFor], map: "idx_reminder_occurrence_scheduled")
  @@index([status], map: "idx_reminder_occurrence_status")
  @@index([followUpId], map: "idx_reminder_occurrence_followup")
}

model Listing {
  id              Int           @id @default(autoincrement())
  propertyId      Int           @map("property_id")
  listingTypeId   Int           @map("listing_type_id")
  listingStatusId Int           @map("listing_status_id")
  price           Decimal
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  listingStatus   ListingStatus @relation(fields: [listingStatusId], references: [id])
  listingType     ListingType   @relation(fields: [listingTypeId], references: [id])
  property        Property      @relation(fields: [propertyId], references: [id])
}

model ListingType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  listings  Listing[]
}

model ListingStatus {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  listings  Listing[]
}

model PropertyPerson {
  id         Int                @id @default(autoincrement())
  propertyId Int                @map("property_id")
  personId   Int                @map("person_id")
  role       PropertyPersonRole @map("role")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime?          @map("deleted_at")
  person     Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, personId, role])
  @@index([propertyId])
  @@index([personId])
  @@index([role])
  @@map("PropertyPerson")
}

enum AssignmentType {
  Following
  Mailboxing
}

enum PhoneType {
  Mobile
  Home
  Work
  Other
}

enum PropertyStatus {
  sin_estado
  noticia_venta
  noticia_alquiler
  antiguo_cliente
}

enum ReminderRecurrenceType {
  once
  daily
  weekly
  monthly
  custom
}

enum ReminderStatus {
  active
  paused
  cancelled
  archived
}

enum ReminderOccurrenceStatus {
  pending
  completed
  skipped
  cancelled
}

enum MailboxingStatus {
  inside
  outside
  no_disturb
}

enum PropertyPersonRole {
  owner
  tenant
}

enum NotificationPreference {
  EMAIL
  WHATSAPP
  SMS
  NONE
}

model FlyerTemplate {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  thumbnailUrl String?   @map("thumbnail_url")
  content      String? // HTML/SVG template content
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  flyers       Flyer[]
}

model Flyer {
  id            Int       @id @default(autoincrement())
  propertyId    Int       @map("property_id")
  templateId    Int       @map("template_id")
  generatedById Int       @map("generated_by_id")
  qrContent     String    @map("qr_content")
  pdfUrl        String?   @map("pdf_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  property    Property        @relation(fields: [propertyId], references: [id])
  template    FlyerTemplate   @relation(fields: [templateId], references: [id])
  generatedBy User            @relation("FlyerGeneratedBy", fields: [generatedById], references: [id])
  shipments   FlyerShipment[]
}

model FlyerShipment {
  id        Int      @id @default(autoincrement())
  flyerId   Int      @map("flyer_id")
  userId    Int      @map("user_id")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  flyer Flyer @relation(fields: [flyerId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model Board {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  isPrivate   Boolean   @default(false)
  creatorId   Int       @map("creator_id")
  ownerId     Int       @map("owner_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  creator User          @relation("BoardCreator", fields: [creatorId], references: [id])
  owner   User          @relation("BoardOwner", fields: [ownerId], references: [id])
  columns BoardColumn[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
}

model BoardColumn {
  id        Int       @id @default(autoincrement())
  boardId   Int       @map("board_id")
  title     String
  order     Int
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  board Board       @relation(fields: [boardId], references: [id])
  cards BoardCard[]
}

model BoardCard {
  id            Int          @id @default(autoincrement())
  columnId      Int          @map("column_id")
  title         String
  description   String?
  priority      CardPriority @default(medium)
  dueDate       DateTime?    @map("due_date")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  creatorId     Int          @map("creator_id")
  responsibleId Int?         @map("responsible_id")

  column      BoardColumn    @relation(fields: [columnId], references: [id])
  creator     User           @relation("CardCreator", fields: [creatorId], references: [id])
  responsible User?          @relation("CardResponsible", fields: [responsibleId], references: [id])
  tags        CardTag[]
  activities  CardActivity[]
}

model CardTag {
  id     Int     @id @default(autoincrement())
  cardId Int     @map("card_id")
  name   String
  color  String?

  card BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CardActivity {
  id        Int      @id @default(autoincrement())
  cardId    Int      @map("card_id")
  userId    Int      @map("user_id")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  card BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])
}

enum CardPriority {
  low
  medium
  high
  critical
}

model OcrHistory {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  imageUrl      String   @map("image_url")
  extractedText String?  @map("extracted_text") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id])

  @@map("OcrHistory")
}

model ForumTopic {
  id        Int       @id @default(autoincrement())
  title     String
  content   String    @db.Text
  category  String    // Nombre libre de la categoría (string)
  authorId  Int       @map("author_id")
  views     Int       @default(0)
  isPinned  Boolean   @default(false) @map("is_pinned")
  isLocked  Boolean   @default(false) @map("is_locked")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author  User        @relation(fields: [authorId], references: [id])
  posts   ForumPost[]
  tags    ForumTag[]

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([category])
  @@map("ForumTopic")
}

model ForumPost {
  id        Int       @id @default(autoincrement())
  topicId   Int       @map("topic_id")
  authorId  Int       @map("author_id")
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  topic  ForumTopic @relation(fields: [topicId], references: [id])
  author User       @relation(fields: [authorId], references: [id])

  @@map("ForumPost")
}

model ForumTag {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  topics ForumTopic[]

  @@map("ForumTag")
}

model ValuationWidgetConfig {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  userId         Int      @map("user_id")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @default("#000000") @map("primary_color")
  secondaryColor String?  @default("#ffffff") @map("secondary_color")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id])
  requests ValuationRequest[]

  @@map("ValuationWidgetConfig")
}

model ValuationRequest {
  id             Int  @id @default(autoincrement())
  widgetConfigId Int? @map("widget_config_id")

  // Property Data
  address      String
  municipality String?
  province     String?
  zipCode      String? @map("zip_code")
  type         String
  builtM2      Float   @map("built_m2")
  rooms        Int
  bathrooms    Int
  yearBuilt    Int?    @map("year_built")
  state        String?
  floor        String?
  hasElevator  Boolean @default(false) @map("has_elevator")
  hasGarage    Boolean @default(false) @map("has_garage")
  hasTerrace   Boolean @default(false) @map("has_terrace")
  hasPool      Boolean @default(false) @map("has_pool")
  hasGarden    Boolean @default(false) @map("has_garden")
  hasStorage   Boolean @default(false) @map("has_storage")

  // Contact Data
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  // Result
  estimatedPrice Decimal @map("estimated_price")
  priceRangeMin  Decimal @map("price_range_min")
  priceRangeMax  Decimal @map("price_range_max")

  createdAt DateTime @default(now()) @map("created_at")

  config ValuationWidgetConfig? @relation(fields: [widgetConfigId], references: [id])

  // Internal Valuation fields
  generatedById Int? @map("generated_by_id")
  propertyId    Int? @map("property_id")

  generatedBy User?     @relation("ValuationGeneratedBy", fields: [generatedById], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])

  companyId Int?     @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  @@map("ValuationRequest")
}

model Company {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users         User[]
  apiKeys       ApiKey[]
  properties    Property[]
  buildings     Building[]
  persons       Person[]
  followUps     FollowUp[]
  reminders     Reminder[]
  boards        Board[]
  forumTopics   ForumTopic[]
  valuationReqs ValuationRequest[]

  @@map("Company")
}

model ApiKey {
  id            Int       @id @default(autoincrement())
  name          String    @map("name")
  keyHash       String    @unique @map("key_hash")
  prefix        String    @map("prefix")
  companyId     Int?      @map("company_id")
  userId        Int       @map("user_id")
  scopes        String[]  @default([])
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  restrictedIps String[]  @default([]) @map("restricted_ips")

  company Company? @relation(fields: [companyId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  logs    ApiLog[]

  @@map("ApiKey")
}

model ApiLog {
  id        Int      @id @default(autoincrement())
  apiKeyId  Int      @map("api_key_id")
  endpoint  String
  method    String
  status    Int
  duration  Int // in ms
  ip        String?
  timestamp DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@map("ApiLog")
}
