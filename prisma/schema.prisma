enum PropertyStatus {
  sin_estado
  noticia_venta
  noticia_alquiler
  antiguo_cliente
}

enum ReminderRecurrenceType {
  once
  daily
  weekly
  monthly
  custom
}

enum ReminderStatus {
  active
  paused
  cancelled
  archived
}

enum ReminderOccurrenceStatus {
  pending
  completed
  skipped
  cancelled
}

enum MailboxingStatus {
  inside
  outside
  no_disturb
}

model PropertyPerson {
  id         Int                @id @default(autoincrement())
  propertyId Int                @map("property_id")
  personId   Int                @map("person_id")
  role       PropertyPersonRole @map("role")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([propertyId, personId, role])
  @@index([propertyId])
  @@index([personId])
  @@index([role])
  @@map("PropertyPerson")
}

enum PropertyPersonRole {
  owner
  tenant
}
